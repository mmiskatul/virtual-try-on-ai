# AI Virtual Try-On Service Environment Configuration
HOST=0.0.0.0
PORT=8000
ENV=development

# Authentication & Secrets Vault (Must be >= 24 chars in production)
AI_SERVICE_API_KEY=vton-ai-service-production-secure-key-32chars
INTERNAL_SERVICE_KEY=vton-internal-service-secret-key-32chars

# Secret Mount Directory (Kubernetes / Docker secrets / HashiCorp Vault)
SECRETS_DIR=/run/secrets

# Model Execution Configuration
MODEL_NAME=VITON-HD-Composite
MODEL_VERSION=v2.4.0-prod
MAX_UPLOAD_SIZE_MB=10

# Storage
RESULTS_DIR=app/static/results
