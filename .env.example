# AI Virtual Try-On Service Environment Configuration
HOST=0.0.0.0
PORT=8000
ENV=development

# Model Execution Configuration
MODEL_NAME=VITON-HD-Composite
MODEL_VERSION=v2.4.0-prod
MAX_UPLOAD_SIZE_MB=10

# =============================================================
# Google Gemini Multimodal Vision & Fashion Synthesis
# =============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# =============================================================
# Fal AI FLUX Pro Virtual Try-On API (fal-ai/flux-pro/v1/vto)
# =============================================================
# Simply paste your Fal AI Key below!
# Format: key_id:key_secret or fal_... (from https://fal.ai/dashboard/keys)
FAL_KEY=

# =============================================================
# Other External AI Virtual Try-On Providers (Optional)
# =============================================================
# Compatible with:
#  - Fal.ai: FAL_KEY (recommended) or VTON_API_KEY
#  - Fashn.ai: paste your Fashn API key in VTON_API_KEY
#  - Replicate: paste your Replicate API token (r8_...) in VTON_API_KEY
#  - Kling AI / Segmind / Custom: paste your API key in VTON_API_KEY and endpoint in VTON_API_URL
# When left blank, the service automatically uses the local VITON-HD vision synthesizer.
VTON_API_KEY=
VTON_API_URL=
VTON_PROVIDER=auto

# Storage & Media Persistence
RESULTS_DIR=app/static/results
# NOTE: Cloudinary image storage is managed centrally by the Backend service (in backend/.env).
# The AI-Service is a stateless inference engine that returns generated output to the Backend,
# which then handles all Cloudinary CDN uploading, caching, and database persistence.
