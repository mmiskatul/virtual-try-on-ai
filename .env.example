# AI Virtual Try-On Service Environment Configuration
HOST=0.0.0.0
PORT=8000
ENV=development

# Model Execution Configuration
MODEL_NAME=VITON-HD-Composite
MODEL_VERSION=v2.4.0-prod
MAX_UPLOAD_SIZE_MB=10

# =============================================================
# External AI Virtual Try-On API (Cloud Provider)
# =============================================================
# Simply paste your VTON API Key below!
# Compatible with:
#  - Fashn.ai: paste your Fashn API key in VTON_API_KEY
#  - Replicate: paste your Replicate API token (r8_...) in VTON_API_KEY
#  - Kling AI / Segmind / Custom: paste your API key in VTON_API_KEY and endpoint in VTON_API_URL
# When left blank, the service automatically uses the local VITON-HD vision synthesizer.
VTON_API_KEY=
VTON_API_URL=
VTON_PROVIDER=auto

# Storage & Cloudinary Configuration
RESULTS_DIR=app/static/results
# Paste your Cloudinary credentials below to store output images on Cloudinary:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=virtual-try-on/results
