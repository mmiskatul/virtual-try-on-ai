HOST=0.0.0.0
PORT=8000
ENV=development

# Shared secret with the backend (must be identical to the backend's INTERNAL_SERVICE_KEY). openssl rand -hex 32
INTERNAL_SERVICE_KEY=
# Local development ONLY: allow calls without the key. Never set this in production.
# ALLOW_UNAUTHENTICATED_DEV=true

# RabbitMQ & Redis Async Worker Config
RABBITMQ_URL=
REDIS_URL=

# Private Storage Config (Supabase Storage or local private mount)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRIVATE_OBJECT_ROOT=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/v1/vto
